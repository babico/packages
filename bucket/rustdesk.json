{
    "version": "1.4.9",
    "description": "Open-source remote desktop software",
    "homepage": "https://rustdesk.com",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rustdesk/rustdesk/releases/download/1.4.9/rustdesk-1.4.9-x86_64.exe",
            "hash": "eaedeb0088e687bf46f7c46a9c6ea5493ce51f3134dfd6acbedb47b5b9136274"
        }
    },
    "installer": {
        "script": [
            "$process = Start-Process -FilePath \"$dir\\rustdesk-1.4.9-x86_64.exe\" -ArgumentList @('/S') -Wait -PassThru",
            "exit $process.ExitCode"
        ]
    },
    "uninstaller": {
        "script": [
            "$process = Start-Process -FilePath \"$env:LOCALAPPDATA\\RustDesk\\rustdesk.exe\" -ArgumentList @('--uninstall', '/S') -Wait -PassThru",
            "exit $process.ExitCode"
        ]
    }
}
